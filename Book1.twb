      <aliases enabled='yes' />
      <column caption='Payment Success Rate' datatype='real' name='[Calculation_1167162891952128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNT([booking_id]) = 0 THEN 0&#13;&#10;ELSE&#13;&#10;    SUM(IF [is_payment_success] = 1 THEN 1 ELSE 0 END)&#13;&#10;    /&#13;&#10;    COUNT([booking_id])&#13;&#10;END' />
      </column>
      <column caption='Payment Failure Rate' datatype='real' name='[Calculation_1167162903789569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNT([booking_id]) = 0 THEN 0&#13;&#10;ELSE&#13;&#10;    SUM([is_payment_failed]) / COUNT([booking_id])&#13;&#10;END' />
      </column>
      <column caption='Calculation1Ticket Issuance Rate' datatype='real' name='[Calculation_1167162913976322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([is_payment_success]) = 0 THEN 0&#13;&#10;ELSE&#13;&#10;    SUM([is_ticket_issued]) / SUM([is_payment_success])&#13;&#10;END' />
      </column>
      <column caption='Refund Rate' datatype='real' name='[Calculation_1167162914340867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([is_ticket_issued]) = 0 THEN 0&#13;&#10;ELSE&#13;&#10;    SUM([is_refunded]) / SUM([is_ticket_issued])&#13;&#10;END' />
      </column>
